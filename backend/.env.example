GEMINI_API_KEY=
ADMIN_PASSWORD=

# Authentication
# JWT_SECRET must be at least 32 characters and not a placeholder; the server refuses to start otherwise.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APPLE_BUNDLE_ID=com.Max0228.BooksBrowser
# Sign in with Apple token revocation on account deletion (#3815): set all three or none; unset = disabled.
APPLE_SIWA_TEAM_ID=
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY_PATH=
APP_STORE_CONNECT_ISSUER_ID=your-app-store-connect-issuer-id
APP_STORE_CONNECT_KEY_ID=your-app-store-connect-key-id
APP_STORE_CONNECT_PRIVATE_KEY_PATH=/app/certs/AuthKey_XXXX.p8
APP_STORE_ROOT_CA_PATH=/app/certs/apple_root_ca.pem

# Sentry error tracking (opt-in: leave SENTRY_DSN empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE resolution order:
#   1. this env (explicit override, used verbatim)
#   2. KG_VERSION env
#   3. /app/VERSION file (deploy writes the git SHA, bind-mounted into the container)
# 2 and 3 are reported as kg-backend@<value> unless the value already contains "@".
# Leave unset in production — deploy SHA from /app/VERSION is the source of truth.
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Mochi keys are user-scoped and should be stored via /api/user/config,
# not as a primary system env. Keep MOCHI_API_KEY only for legacy admin scripts if needed.
