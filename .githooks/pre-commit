#!/usr/bin/env bash
# pre-commit — design-system 與 UI quality gate 的本地 best-effort 檢查。
#
# 啟用（每個 clone 各跑一次，不隨 commit 傳播）: ops/install_hooks.sh
# 驗證: ops/install_hooks.sh --check   停用: ops/install_hooks.sh --uninstall
#
# 設計：只在相關路徑被 stage 時才跑（否則每次 commit 太重）；缺 uv/node/rg
# 時告警跳過而非 brick commit（CI 才是硬 gate）。
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"

DS_PATTERN='^(design-system/|ops/(gen_web_tokens|gen_figma_sets|token_drift_check|component_fidelity_check|verify_design_system)\.(py|sh)|ios/BooksAndVocab/(Models|UIComponents)/|backend/static/kg-(tokens|components)\.css)'

UQ_TOOLING_PATTERN='^ops/(ui_quality_gate|ui_quality_plane|ui_token_lint|plain_deadzone_lint|tap_a11y_lint|_swift_scan|i18n_lint|catalyst_lint|injection_lint|_i18n_|_inject_shared)'
UQ_PATTERN="^ios/BooksAndVocab/.*\\.(swift|strings|stringsdict)|$UQ_TOOLING_PATTERN"

run_design_system() {
  if ! grep -qE "$DS_PATTERN" <<<"$STAGED_FILES"; then
    return 0
  fi

  if ! command -v uv >/dev/null 2>&1 || ! command -v node >/dev/null 2>&1; then
    printf '[pre-commit] \033[33m⚠ 缺 uv 或 node，跳過 design-system gate（CI 仍會擋）\033[0m\n' >&2
    return 0
  fi

  printf '[pre-commit] design-system 變動 → verify_design_system.sh\n'
  "$REPO/ops/verify_design_system.sh"
}

run_ui_quality_gate() {
  if ! grep -qE "$UQ_PATTERN" <<<"$STAGED_FILES"; then
    return 0
  fi

  if ! command -v uv >/dev/null 2>&1 || ! command -v rg >/dev/null 2>&1; then
    printf '[pre-commit] \033[33m⚠ 缺 uv 或 rg，跳過 UI quality gate（CI 仍會擋）\033[0m\n' >&2
    return 0
  fi

  # 只看這筆 commit：不帶檔案清單時 gate 會退回 `--since origin/main`（整條 branch
  # 加未 stage 的改動）。lint 工具本身被改時沒有 plane trigger 會命中，`--files`
  # 會選到 0 個機制而假綠，所以改跑全部 fast 機制。
  local scope=()
  if grep -qE "$UQ_TOOLING_PATTERN" <<<"$STAGED_FILES"; then
    scope=(--all-mechanisms)
  else
    local f
    scope=(--files)
    while IFS= read -r -d '' f; do
      scope+=("$f")
    done < <(git diff --cached --name-only --diff-filter=ACMR -z)
  fi

  printf '[pre-commit] UI 變動 → ui_quality_gate.sh --tier fast --execute %s\n' "${scope[0]}"
  "$REPO/ops/ui_quality_gate.sh" --tier fast --execute "${scope[@]}"
}

run_design_system
run_ui_quality_gate
